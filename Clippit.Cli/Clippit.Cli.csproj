<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(NativeAot)' == 'true'">net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsCliProject>true</IsCliProject>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CliChangelogPath>$(MSBuildThisFileDirectory)..\CHANGELOG.md</CliChangelogPath>
    <CliChangelogText>$([System.IO.File]::ReadAllText('$(CliChangelogPath)'))</CliChangelogText>
    <VersionPrefix>$([System.Text.RegularExpressions.Regex]::Match('$(CliChangelogText)', '(?m)^## \[([0-9]+\.[0-9]+\.[0-9]+(?:[-+][^\]]+)?)\]').Groups[1].Value)</VersionPrefix>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clippit</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64;any</ToolPackageRuntimeIdentifiers>
    <PackageId>Clippit.Cli</PackageId>
    <Description>CLI tool for Clippit — PowerTools for OpenXml (PowerPoint, Word, Excel)</Description>
    <PackageTags>OpenXML;PowerTools;PowerPoint;Word;Excel;CLI;tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/sergey-tihon/Clippit</PackageProjectUrl>
    <PackageIcon>logo.jpeg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- NativeAOT is opt-in via -p:NativeAot=true for npm binaries (dotnet publish -r <rid>) and
         RID-specific dotnet tool packages (dotnet pack -r <rid>). Plain builds, tests, and the
         framework-dependent any tool package target net10.0 and net11.0. -->
    <PublishAot Condition="'$(NativeAot)' == 'true'">true</PublishAot>
    <OptimizationPreference Condition="'$(NativeAot)' == 'true'">Size</OptimizationPreference>
    <StackTraceSupport Condition="'$(NativeAot)' == 'true'">false</StackTraceSupport>
    <XmlResolverIsNetworkingEnabledByDefault Condition="'$(NativeAot)' == 'true'"
      >false</XmlResolverIsNetworkingEnabledByDefault>
    <InvariantGlobalization Condition="'$(NativeAot)' == 'true'">true</InvariantGlobalization>
    <!-- NativeAOT uses invariant globalization, so localized satellite resources cannot be selected. -->
    <SatelliteResourceLanguages Condition="'$(NativeAot)' == 'true'">en</SatelliteResourceLanguages>
    <StripSymbols Condition="'$(NativeAot)' == 'true'">true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\docs\images\logo.jpeg" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Skills\clippit\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.CommandLine 3.x is still preview; keep the exact version pinned and revisit when it reaches GA. -->
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clippit\Clippit.csproj" />
  </ItemGroup>

  <!-- SkiaSharp ships a universal macOS dylib; keep only the slice for the target RID. -->
  <Target
    Name="ThinMacOSNativeLibraries"
    AfterTargets="Publish"
    Condition="'$(PublishAot)' == 'true' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))"
  >
    <PropertyGroup>
      <_ThinArch Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">arm64</_ThinArch>
      <_ThinArch Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64</_ThinArch>
    </PropertyGroup>
    <ItemGroup>
      <_FatDylib Include="$(PublishDir)*.dylib" />
    </ItemGroup>
    <Exec
      Command="if lipo -info &quot;%(_FatDylib.FullPath)&quot; | grep -q &quot;Architectures in the fat file&quot;; then lipo &quot;%(_FatDylib.FullPath)&quot; -thin $(_ThinArch) -output &quot;%(_FatDylib.FullPath).thin&quot; &amp;&amp; mv -f &quot;%(_FatDylib.FullPath).thin&quot; &quot;%(_FatDylib.FullPath)&quot;; fi"
      Condition="'@(_FatDylib)' != ''"
    />
  </Target>

  <Target
    Name="RenameNativeAotExecutable"
    AfterTargets="Publish"
    Condition="'$(PublishAot)' == 'true' and '$(_IsPacking)' != 'true'"
  >
    <PropertyGroup>
      <NativeAotSourceName Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))"
        >$(AssemblyName).exe</NativeAotSourceName>
      <NativeAotSourceName Condition="!$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))"
        >$(AssemblyName)</NativeAotSourceName>
      <NativeAotExecutableName Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))"
        >clippit.exe</NativeAotExecutableName>
      <NativeAotExecutableName Condition="!$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))"
        >clippit</NativeAotExecutableName>
    </PropertyGroup>
    <Copy
      SourceFiles="$(PublishDir)$(NativeAotSourceName)"
      DestinationFiles="$(PublishDir)$(NativeAotExecutableName)"
      Condition="Exists('$(PublishDir)$(NativeAotSourceName)') and '$(NativeAotSourceName)' != '$(NativeAotExecutableName)'"
    />
    <Delete
      Files="$(PublishDir)$(NativeAotSourceName)"
      Condition="Exists('$(PublishDir)$(NativeAotExecutableName)') and '$(NativeAotSourceName)' != '$(NativeAotExecutableName)'"
    />
  </Target>
  <!-- Tool packages do not need debug symbols (.pdb, Linux .dbg, macOS .dSYM). -->
  <Target Name="ExcludeDebugSymbolsFromToolPackage" AfterTargets="PackTool" Condition="'$(PackAsTool)' == 'true'">
    <ItemGroup>
      <TfmSpecificPackageFile
        Remove="@(TfmSpecificPackageFile)"
        Condition="'%(TfmSpecificPackageFile.Extension)' == '.pdb' or '%(TfmSpecificPackageFile.Extension)' == '.dbg' or $([System.String]::Copy('%(TfmSpecificPackageFile.FullPath)').Contains('.dSYM'))"
      />
    </ItemGroup>
  </Target>
</Project>
